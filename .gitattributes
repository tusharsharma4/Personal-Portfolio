# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Explicitly declare binary files to prevent checkout corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
*.wav binary
